# Anzahl der Tische und Preise
NUM_TABLES=30
PRICE_STANDARD=15.00
PRICE_INTERNAL=10.00
CURRENCY=EUR

# PayPal REST App (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=deine_client_id
PAYPAL_CLIENT_SECRET=dein_client_secret
PAYPAL_MODE=sandbox

# Optional: Pfad zur SQLite-Datei
DB_PATH=flohmarkt.db

# Admin-Bereich (/admin)
ADMIN_PASSWORD=bitte-aendern
SECRET_KEY=ein-zufaelliger-langer-string
