# Prices, tables and payment deadlines are configured in the admin portal.
# No pricing/table/deadline environment variables are required.
CURRENCY=EUR

# Which payment methods to offer, comma-separated: "paypal,sepa" (both,
# default), "sepa" (bank transfer only), or "paypal" (PayPal only). With
# only one enabled, the payment-method choice is hidden from visitors and
# that method is used automatically. Invalid/empty values fall back to
# both being enabled.
PAYMENT_METHODS=paypal,sepa

# PayPal REST app (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_MODE=sandbox

# Optional but recommended: PayPal webhook as a fallback in case the
# browser's own confirmation call never arrives (e.g. tab closed right
# after paying). Create the webhook in the PayPal Developer Dashboard for
# this app, pointing at https://<your-domain>/webhooks/paypal, subscribed
# to at least the "Payment capture completed" event. Leave empty to
# disable webhook handling (payments still work via the browser callback).
PAYPAL_WEBHOOK_ID=

# Optional: path to the SQLite file
DB_PATH=flohmarkt.db

# Admin area (/admin)
ADMIN_PASSWORD=please-change
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: SMTP for the payment confirmation email and the SEPA bank
# transfer email. Leave SMTP_HOST empty to disable sending emails entirely
# (SEPA reservations then have no way to receive the bank details, so set
# this before enabling bank transfer as a payment option).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
