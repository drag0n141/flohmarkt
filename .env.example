# Number of tables and prices
NUM_TABLES=30
PRICE_STANDARD=15.00
PRICE_INTERNAL=10.00
CURRENCY=EUR

# PayPal REST app (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_MODE=sandbox

# Optional: path to the SQLite file
DB_PATH=flohmarkt.db

# Admin area (/admin)
ADMIN_PASSWORD=please-change
SECRET_KEY=a-random-long-string
